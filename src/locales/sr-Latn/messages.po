#. VoiceOver only: the separator between the parts of a list read aloud, e.g. "Unread, Maya invited you to Picnic, 2 min ago". English is a comma and a space.
#: src/i18n/spokenList.ts
msgid ", "
msgstr ", "

#. A refusal from the server when a name is too short, under the name field on Set name and Account (# is the minimum, 3). The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "{characters, plural, other {please enter at least # characters}}"
msgstr "{characters, plural, one {Unesite najmanje # znak.} few {Unesite najmanje # znaka.} other {Unesite najmanje # znakova.}}"

#. A link that is waiting before it can send another code. # is a countdown in seconds; "s" abbreviates seconds.
#: src/screens/SignInScreen.tsx
msgid "{cooldown, plural, other {Resend code in #s}}"
msgstr "{cooldown, plural, one {Ponovo pošalji kod za # s} few {Ponovo pošalji kod za # s} other {Ponovo pošalji kod za # s}}"

#. Title when a search of a list's items loaded so far finds nothing; the rest are still to load. # is how many were searched.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {No matches in the # loaded items}}"
msgstr "{count, plural, one {Nema podudaranja u # učitanoj stavci} few {Nema podudaranja u # učitane stavke} other {Nema podudaranja u # učitanih stavki}}"

#. Title when a search of the lists loaded so far finds nothing; the rest are still to load. # is how many were searched.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {No matches in the # loaded lists}}"
msgstr "{count, plural, one {Nema podudaranja u # učitanoj listi} few {Nema podudaranja u # učitane liste} other {Nema podudaranja u # učitanih lista}}"

#. Under the search field when the rest of a list's items could not load (offline). # is how many were searched.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searched the # loaded items. The rest need a connection.}}"
msgstr "{count, plural, one {Pretražena je # učitana stavka. Za ostale je potrebna internet veza.} few {Pretražene su # učitane stavke. Za ostale je potrebna internet veza.} other {Pretraženo je # učitanih stavki. Za ostale je potrebna internet veza.}}"

#. Under the search field when the rest of the lists could not load (offline). # is how many were searched.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searched the # loaded lists. The rest need a connection.}}"
msgstr "{count, plural, one {Pretražena je # učitana lista. Za ostale je potrebna internet veza.} few {Pretražene su # učitane liste. Za ostale je potrebna internet veza.} other {Pretraženo je # učitanih lista. Za ostale je potrebna internet veza.}}"

#. Under the search field when only a list's first items could be searched: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searched the first # items.}}"
msgstr "{count, plural, one {Pretražena je prva # stavka.} few {Pretražene su prve # stavke.} other {Pretraženo je prvih # stavki.}}"

#. Under the search field when only the first lists could be searched: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searched the first # lists.}}"
msgstr "{count, plural, one {Pretražena je prva # lista.} few {Pretražene su prve # liste.} other {Pretraženo je prvih # lista.}}"

#. Under the search field while the rest of a list's items load in the background. # is how many are loaded so far.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searching # loaded items · loading the rest…}}"
msgstr "{count, plural, one {Pretražuje se # učitana stavka · učitava se ostatak…} few {Pretražuju se # učitane stavke · učitava se ostatak…} other {Pretražuje se # učitanih stavki · učitava se ostatak…}}"

#. Under the search field while the rest of the lists load in the background. # is how many are loaded so far.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Searching # loaded lists · loading the rest…}}"
msgstr "{count, plural, one {Pretražuje se # učitana lista · učitava se ostatak…} few {Pretražuju se # učitane liste · učitava se ostatak…} other {Pretražuje se # učitanih lista · učitava se ostatak…}}"

#. Under the sort buttons when the rest of a list's items could not load (offline). # is how many were sorted.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the # loaded items. The rest need a connection.}}"
msgstr "{count, plural, one {Sortirana je # učitana stavka. Za ostale je potrebna internet veza.} few {Sortirane su # učitane stavke. Za ostale je potrebna internet veza.} other {Sortirano je # učitanih stavki. Za ostale je potrebna internet veza.}}"

#. Under the sort buttons when the rest of the lists could not load (offline). # is how many were sorted.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the # loaded lists. The rest need a connection.}}"
msgstr "{count, plural, one {Sortirana je # učitana lista. Za ostale je potrebna internet veza.} few {Sortirane su # učitane liste. Za ostale je potrebna internet veza.} other {Sortirano je # učitanih lista. Za ostale je potrebna internet veza.}}"

#. Under the sort buttons when only a list's first items could be sorted: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the first # items.}}"
msgstr "{count, plural, one {Sortirana je prva # stavka.} few {Sortirane su prve # stavke.} other {Sortirano je prvih # stavki.}}"

#. Under the sort buttons when only the first lists could be sorted: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the first # lists.}}"
msgstr "{count, plural, one {Sortirana je prva # lista.} few {Sortirane su prve # liste.} other {Sortirano je prvih # lista.}}"

#. Under the sort buttons while the rest of a list's items load in the background. # is how many are loaded so far.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorting # loaded items · loading the rest…}}"
msgstr "{count, plural, one {Sortira se # učitana stavka · učitava se ostatak…} few {Sortiraju se # učitane stavke · učitava se ostatak…} other {Sortira se # učitanih stavki · učitava se ostatak…}}"

#. Under the sort buttons while the rest of the lists load in the background. # is how many are loaded so far.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorting # loaded lists · loading the rest…}}"
msgstr "{count, plural, one {Sortira se # učitana lista · učitava se ostatak…} few {Sortiraju se # učitane liste · učitava se ostatak…} other {Sortira se # učitanih lista · učitava se ostatak…}}"

#. How long ago something happened, in whole days, abbreviated: short, small print beside other text.
#: src/lib/ago.ts
msgid "{days, plural, other {# d ago}}"
msgstr "{days, plural, one {pre # d} few {pre # d} other {pre # d}}"

#. Under the title when a list's bin is empty: how long deleted items are kept. # is a number of days (30).
#: src/screens/ListDetailScreen.tsx
msgid "{days, plural, other {Deleted items wait here for # days.}}"
msgstr "{days, plural, one {Obrisane stavke čekaju ovde # dan.} few {Obrisane stavke čekaju ovde # dana.} other {Obrisane stavke čekaju ovde # dana.}}"

#. Under the title when the bin of lists is empty: how long deleted lists are kept. # is a number of days (30).
#: src/screens/ListsScreen.tsx
msgid "{days, plural, other {Deleted lists wait here for # days.}}"
msgstr "{days, plural, one {Obrisane liste čekaju ovde # dan.} few {Obrisane liste čekaju ovde # dana.} other {Obrisane liste čekaju ovde # dana.}}"

#. How long ago something happened, in whole hours, abbreviated: short, small print beside other text.
#: src/lib/ago.ts
msgid "{hours, plural, other {# h ago}}"
msgstr "{hours, plural, one {pre # č} few {pre # č} other {pre # č}}"

#. VoiceOver only: a list someone else shared with this person. {listName} is the list's name as typed: never inflect it.
#: src/components/ListRow.tsx
msgid "{listName}, shared with you"
msgstr "{listName}, podeljeno sa vama"

#. A refusal from the server on the Sharing screen: the member being made an owner already owns the most lists allowed (# is that limit, 100). "they" is one person whose gender is unknown: avoid gendered forms. The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "{max, plural, other {they already own # lists}}"
msgstr "{max, plural, one {Ta osoba već poseduje # listu.} few {Ta osoba već poseduje # liste.} other {Ta osoba već poseduje # lista.}}"

#. A refusal from the server on the Sharing screen: the person is already a member of the most lists allowed (# is that limit, 1,000). "they" is one person whose gender is unknown: avoid gendered forms. The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "{max, plural, other {they are already on # lists}}"
msgstr "{max, plural, one {Ta osoba već ima # listu.} few {Ta osoba već ima # liste.} other {Ta osoba već ima # lista.}}"

#. A refusal from the server: the list holds the most items allowed (# is that limit, 1,000). Rarely shown; the app usually says this in its own words. The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "{max, plural, other {this list already has # items}}"
msgstr "{max, plural, one {Ova lista već ima # stavku.} few {Ova lista već ima # stavke.} other {Ova lista već ima # stavki.}}"

#. Shown when a list holds the most items allowed (# is that limit, 1,000).
#: src/lib/limits.ts
msgid "{max, plural, other {This list is full: # items at most.}}"
msgstr "{max, plural, one {Ova lista je puna: najviše # stavka.} few {Ova lista je puna: najviše # stavke.} other {Ova lista je puna: najviše # stavki.}}"

#. Shown when the person owns the most lists allowed (# is that limit, 100).
#: src/lib/limits.ts
msgid "{max, plural, other {You own # lists. Delete one or hand one over to make room.}}"
msgstr "{max, plural, one {Posedujete # listu. Obrišite neku ili je prenesite na drugog vlasnika da biste oslobodili mesto.} few {Posedujete # liste. Obrišite neku ili je prenesite na drugog vlasnika da biste oslobodili mesto.} other {Posedujete # lista. Obrišite neku ili je prenesite na drugog vlasnika da biste oslobodili mesto.}}"

#. Shown when the person is a member of the most lists allowed, their own and shared ones (# is that limit, 1,000).
#: src/lib/limits.ts
msgid "{max, plural, other {You're on # lists. Delete or leave one to make room.}}"
msgstr "{max, plural, one {Imate # listu. Obrišite neku ili je napustite da biste oslobodili mesto.} few {Imate # liste. Obrišite neku ili je napustite da biste oslobodili mesto.} other {Imate # lista. Obrišite neku ili je napustite da biste oslobodili mesto.}}"

#. How long ago something happened, in whole minutes, abbreviated: short, small print beside other text.
#: src/lib/ago.ts
msgid "{minutes, plural, other {# min ago}}"
msgstr "{minutes, plural, one {pre # min} few {pre # min} other {pre # min}}"

#. "Sign in with Apple" is Apple's feature: use the name Apple uses in this language. # is a number of minutes (5).
#: src/lib/appleSignIn.ts
msgid "{minutes, plural, other {Sign in with Apple needs a few minutes to reset. Try again in # minutes.}}"
msgstr "{minutes, plural, one {Prijava pomoću Apple-a mora da se resetuje, što traje nekoliko minuta. Pokušajte ponovo za # minut.} few {Prijava pomoću Apple-a mora da se resetuje, što traje nekoliko minuta. Pokušajte ponovo za # minuta.} other {Prijava pomoću Apple-a mora da se resetuje, što traje nekoliko minuta. Pokušajte ponovo za # minuta.}}"

#. The person's own row among a list's members. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense.
#: src/screens/SharingScreen.tsx
msgid "{name} (you)"
msgstr "{name} (vi)"

#. A notification: someone accepted this person's invitation to a list. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense; use a present tense, a passive or a label form. {listName} is the list's name as typed: never inflect it.
#: src/screens/NotificationsScreen.tsx
msgid "{name} accepted your invitation to {listName}"
msgstr "{name} prihvata vašu pozivnicu za listu {listName}"

#. A notification: someone declined this person's invitation to a list. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense; use a present tense, a passive or a label form. {listName} is the list's name as typed: never inflect it.
#: src/screens/NotificationsScreen.tsx
msgid "{name} declined your invitation to {listName}"
msgstr "{name} odbija vašu pozivnicu za listu {listName}"

#. A notification: someone invited this person to a list. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense; use a present tense, a passive or a label form. {listName} is the list's name as typed: never inflect it.
#: src/screens/NotificationsScreen.tsx
msgid "{name} invited you to {listName}"
msgstr "{name} vas poziva na listu {listName}"

#. The confirm before blocking the person who sent an invitation. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense; use a present tense, a passive or a label form. “Blocked people” is the name of that screen: use its translation.
#: src/screens/NotificationsScreen.tsx
msgid "{name} will be told you declined, and you won't see invitations from them any more. Unblock them any time under Blocked people."
msgstr "{name} će dobiti obaveštenje da ste odbili pozivnicu, a vi više nećete videti pozivnice ove osobe. Deblokiranje je moguće u svakom trenutku u odeljku „Blokirane osobe“."

#. The confirm before removing someone from a list: what it costs them. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense.
#: src/screens/SharingScreen.tsx
msgid "{name} will lose access to this list until someone invites them again."
msgstr "{name} će izgubiti pristup ovoj listi dok ponovo ne dobije pozivnicu."

#. The confirm before withdrawing an invitation. {name} is a person's name as they typed it: never inflect it. Their gender is unknown, so avoid a gendered past tense. Phrase it so the name needs no ending.
#: src/screens/SharingScreen.tsx
msgid "{name}'s invitation will be withdrawn."
msgstr "Pozivnica upućena osobi {name} biće povučena."

#. VoiceOver only: two sort orders in priority order, e.g. "to do first, then A to Z".
#: src/lib/searchCopy.ts
msgid "{order}, then {next}"
msgstr "{order}, zatim {next}"

#. A quiet banner while changes made offline wait to be sent. # is how many changes.
#: src/components/SyncBanner.tsx
msgid "{pending, plural, one {# change will sync when you're back online} other {# changes will sync when you're back online}}"
msgstr "{pending, plural, one {# izmena će se sinhronizovati kada se ponovo povežete} few {# izmene će se sinhronizovati kada se ponovo povežete} other {# izmena će se sinhronizovati kada se ponovo povežete}}"

#. Under the email field on the sign-in screen: a new code was asked for too soon after the last one. # is how many seconds are left, and can be 0.
#: src/lib/serverMessages.ts
msgid "{seconds, plural, other {For security purposes, you can only request this after # seconds.}}"
msgstr "{seconds, plural, one {Iz bezbednosnih razloga ovo možete da zatražite tek za # sekundu.} few {Iz bezbednosnih razloga ovo možete da zatražite tek za # sekunde.} other {Iz bezbednosnih razloga ovo možete da zatražite tek za # sekundi.}}"

#. Under the search field when the rest of the lists could not load (offline). {loaded} is how many were searched; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Searched {loaded} of # lists. The rest need a connection.}}"
msgstr "{total, plural, one {Pretraženo: {loaded} od # liste. Za ostale je potrebna internet veza.} few {Pretraženo: {loaded} od # liste. Za ostale je potrebna internet veza.} other {Pretraženo: {loaded} od # lista. Za ostale je potrebna internet veza.}}"

#. Under the search field while the rest of the lists load in the background. {loaded} is how many are loaded so far; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Searching {loaded} of # lists · loading the rest…}}"
msgstr "{total, plural, one {Pretraga: {loaded} od # liste · učitava se ostatak…} few {Pretraga: {loaded} od # liste · učitava se ostatak…} other {Pretraga: {loaded} od # lista · učitava se ostatak…}}"

#. Under the sort buttons when the rest of the lists could not load (offline). {loaded} is how many were sorted; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Sorted {loaded} of # lists. The rest need a connection.}}"
msgstr "{total, plural, one {Sortirano: {loaded} od # liste. Za ostale je potrebna internet veza.} few {Sortirano: {loaded} od # liste. Za ostale je potrebna internet veza.} other {Sortirano: {loaded} od # lista. Za ostale je potrebna internet veza.}}"

#. Under the sort buttons while the rest of the lists load in the background. {loaded} is how many are loaded so far; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Sorting {loaded} of # lists · loading the rest…}}"
msgstr "{total, plural, one {Sortiranje: {loaded} od # liste · učitava se ostatak…} few {Sortiranje: {loaded} od # liste · učitava se ostatak…} other {Sortiranje: {loaded} od # lista · učitava se ostatak…}}"

#. VoiceOver only: the bell button's value, how many notifications are unread. # is that number.
#: src/screens/ListsScreen.tsx
msgid "{unreadCount, plural, other {# unread}}"
msgstr "{unreadCount, plural, one {# nepročitano} few {# nepročitana} other {# nepročitanih}}"

#. A refusal from the server on the Sharing screen: removing or demoting this owner would leave the list with none. The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "a list must keep at least one owner"
msgstr "Lista mora da ima bar jednog vlasnika."

#. Under the members, for a list's only owner: why they cannot leave or step down.
#: src/screens/SharingScreen.tsx
msgid "A list must keep at least one owner."
msgstr "Lista mora da ima bar jednog vlasnika."

