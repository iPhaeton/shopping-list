msgstr "{days, plural, one {# dzień temu} few {# dni temu} many {# dni temu} other {# dnia temu}}"

#. Under the title when a list's bin is empty: how long deleted items are kept. # is a number of days (30).
#: src/screens/ListDetailScreen.tsx
msgid "{days, plural, other {Deleted items wait here for # days.}}"
msgstr "{days, plural, one {Usunięte pozycje są tu przechowywane przez # dzień.} few {Usunięte pozycje są tu przechowywane przez # dni.} many {Usunięte pozycje są tu przechowywane przez # dni.} other {Usunięte pozycje są tu przechowywane przez # dnia.}}"

#. Under the title when the bin of lists is empty: how long deleted lists are kept. # is a number of days (30).
#: src/screens/ListsScreen.tsx
msgid "{days, plural, other {Deleted lists wait here for # days.}}"
msgstr "{days, plural, one {Usunięte listy są tu przechowywane przez # dzień.} few {Usunięte listy są tu przechowywane przez # dni.} many {Usunięte listy są tu przechowywane przez # dni.} other {Usunięte listy są tu przechowywane przez # dnia.}}"

