msgstr "{count, plural, one {Hledání v # načteném seznamu · načítání zbytku…} few {Hledání v # načtených seznamech · načítání zbytku…} many {Hledání v # načteného seznamu · načítání zbytku…} other {Hledání v # načtených seznamech · načítání zbytku…}}"

#. Under the sort buttons when the rest of a list's items could not load (offline). # is how many were sorted.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the # loaded items. The rest need a connection.}}"
msgstr "{count, plural, one {Seřazena # načtená položka. Ostatní vyžadují připojení.} few {Seřazeny # načtené položky. Ostatní vyžadují připojení.} many {Seřazeno # načtené položky. Ostatní vyžadují připojení.} other {Seřazeno # načtených položek. Ostatní vyžadují připojení.}}"

