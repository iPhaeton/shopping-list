msgstr "{total, plural, one {Pesquisada {loaded} de # lista. As restantes precisam de ligação.} many {Pesquisadas {loaded} de # listas. As restantes precisam de ligação.} other {Pesquisadas {loaded} de # listas. As restantes precisam de ligação.}}"

#. Under the search field while the rest of the lists load in the background. {loaded} is how many are loaded so far; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Searching {loaded} of # lists · loading the rest…}}"
msgstr "{total, plural, one {A pesquisar {loaded} de # lista · a carregar as restantes…} many {A pesquisar {loaded} de # listas · a carregar as restantes…} other {A pesquisar {loaded} de # listas · a carregar as restantes…}}"

#. Under the sort buttons when the rest of the lists could not load (offline). {loaded} is how many were sorted; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Sorted {loaded} of # lists. The rest need a connection.}}"
msgstr "{total, plural, one {Ordenada {loaded} de # lista. As restantes precisam de ligação.} many {Ordenadas {loaded} de # listas. As restantes precisam de ligação.} other {Ordenadas {loaded} de # listas. As restantes precisam de ligação.}}"

#. Under the sort buttons while the rest of the lists load in the background. {loaded} is how many are loaded so far; # is the approximate total.
#: src/lib/searchCopy.ts
msgid "{total, plural, other {Sorting {loaded} of # lists · loading the rest…}}"
msgstr "{total, plural, one {A ordenar {loaded} de # lista · a carregar as restantes…} many {A ordenar {loaded} de # listas · a carregar as restantes…} other {A ordenar {loaded} de # listas · a carregar as restantes…}}"

#. VoiceOver only: the bell button's value, how many notifications are unread. # is that number.
