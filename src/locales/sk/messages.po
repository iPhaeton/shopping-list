msgstr "{count, plural, one {Hľadá sa v # načítanom zozname · načítava sa zvyšok…} few {Hľadá sa v # načítaných zoznamoch · načítava sa zvyšok…} many {Hľadá sa v # načítaných zoznamoch · načítava sa zvyšok…} other {Hľadá sa v # načítaných zoznamoch · načítava sa zvyšok…}}"

#. Under the sort buttons when the rest of a list's items could not load (offline). # is how many were sorted.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the # loaded items. The rest need a connection.}}"
msgstr "{count, plural, one {Zoradili sme # načítanú položku. Na ostatné potrebujete pripojenie.} few {Zoradili sme # načítané položky. Na ostatné potrebujete pripojenie.} many {Zoradili sme # načítanej položky. Na ostatné potrebujete pripojenie.} other {Zoradili sme # načítaných položiek. Na ostatné potrebujete pripojenie.}}"

#. Under the sort buttons when the rest of the lists could not load (offline). # is how many were sorted.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the # loaded lists. The rest need a connection.}}"
msgstr "{count, plural, one {Zoradili sme # načítaný zoznam. Na ostatné potrebujete pripojenie.} few {Zoradili sme # načítané zoznamy. Na ostatné potrebujete pripojenie.} many {Zoradili sme # načítaného zoznamu. Na ostatné potrebujete pripojenie.} other {Zoradili sme # načítaných zoznamov. Na ostatné potrebujete pripojenie.}}"

#. Under the sort buttons when only a list's first items could be sorted: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the first # items.}}"
msgstr "{count, plural, one {Zoradili sme prvú # položku.} few {Zoradili sme prvé # položky.} many {Zoradili sme prvej # položky.} other {Zoradili sme prvých # položiek.}}"

#. Under the sort buttons when only the first lists could be sorted: there are too many to load. # is how many.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorted the first # lists.}}"
msgstr "{count, plural, one {Zoradili sme prvý # zoznam.} few {Zoradili sme prvé # zoznamy.} many {Zoradili sme prvého # zoznamu.} other {Zoradili sme prvých # zoznamov.}}"

#. Under the sort buttons while the rest of a list's items load in the background. # is how many are loaded so far.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {Sorting # loaded items · loading the rest…}}"
msgstr "{count, plural, one {Zoraďuje sa # načítaná položka · načítava sa zvyšok…} few {Zoraďujú sa # načítané položky · načítava sa zvyšok…} many {Zoraďuje sa # načítanej položky · načítava sa zvyšok…} other {Zoraďuje sa # načítaných položiek · načítava sa zvyšok…}}"

