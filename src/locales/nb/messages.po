msgid "that account no longer exists"
msgstr "Den kontoen finnes ikke lenger."

#. An error from the server: the Apple ID used is not the one linked to this account.
#: src/lib/serverMessages.ts
msgid "That Apple ID isn't the one this account signs in with."
msgstr "Den Apple-ID-en er ikke den denne kontoen logger på med."

