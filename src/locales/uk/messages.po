#. VoiceOver only: the separator between the parts of a list read aloud, e.g. "Unread, Maya invited you to Picnic, 2 min ago". English is a comma and a space.
#: src/i18n/spokenList.ts
msgid ", "
msgstr ", "

#. A refusal from the server when a name is too short, under the name field on Set name and Account (# is the minimum, 3). The English is the database's own words, lowercase with no full stop: write a natural sentence, capitalised and punctuated as your language's UI would be.
#: src/lib/serverMessages.ts
msgid "{characters, plural, other {please enter at least # characters}}"
msgstr "{characters, plural, one {Введіть щонайменше # символ.} few {Введіть щонайменше # символи.} many {Введіть щонайменше # символів.} other {Введіть щонайменше # символу.}}"

#. A link that is waiting before it can send another code. # is a countdown in seconds; "s" abbreviates seconds.
#: src/screens/SignInScreen.tsx
msgid "{cooldown, plural, other {Resend code in #s}}"
msgstr "{cooldown, plural, one {Надіслати код повторно через # с} few {Надіслати код повторно через # с} many {Надіслати код повторно через # с} other {Надіслати код повторно через # с}}"

#. Title when a search of a list's items loaded so far finds nothing; the rest are still to load. # is how many were searched.
#: src/lib/searchCopy.ts
msgid "{count, plural, other {No matches in the # loaded items}}"
msgstr "{count, plural, one {Немає збігів серед # завантаженого пункту} few {Немає збігів серед # завантажених пунктів} many {Немає збігів серед # завантажених пунктів} other {Немає збігів серед # завантаженого пункту}}"

