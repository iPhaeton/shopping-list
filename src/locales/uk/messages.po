msgstr "{days, plural, one {# дн. тому} few {# дн. тому} many {# дн. тому} other {# дн. тому}}"

#. Under the title when a list's bin is empty: how long deleted items are kept. # is a number of days (30).
#: src/screens/ListDetailScreen.tsx
msgid "{days, plural, other {Deleted items wait here for # days.}}"
msgstr "{days, plural, one {Видалені пункти зберігаються тут # день.} few {Видалені пункти зберігаються тут # дні.} many {Видалені пункти зберігаються тут # днів.} other {Видалені пункти зберігаються тут # дня.}}"

#. Under the title when the bin of lists is empty: how long deleted lists are kept. # is a number of days (30).
#: src/screens/ListsScreen.tsx
msgid "{days, plural, other {Deleted lists wait here for # days.}}"
msgstr "{days, plural, one {Видалені списки зберігаються тут # день.} few {Видалені списки зберігаються тут # дні.} many {Видалені списки зберігаються тут # днів.} other {Видалені списки зберігаються тут # дня.}}"

