# Copy to .env (gitignored) and restart the dev server — Metro inlines EXPO_PUBLIC_* at build time.
#
# There are two Supabase environments, and the client picks between them at runtime rather than at
# build time: one `expo start` serves the browser and Expo Go from the same bundle, so a build-time
# split cannot tell them apart. See src/lib/supabaseTarget.ts.
#
#   browser and iOS simulator  → local   (the Docker stack from `npx supabase start`)
#   physical device in Expo Go → cloud
#
# Local values are the stack's defaults. The anon key derives from the JWT secret in
# supabase/config.toml, so it is identical for anyone who checks this repo out and is safe to
# commit. Re-read both any time with `npx supabase status`.

EXPO_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY_LOCAL=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The cloud key is left blank on purpose — fill it in your own .env with:
#
#   npx supabase projects api-keys --project-ref gvosanjceygakbubjfkv
#
# Use the publishable key (sb_publishable_…), not the legacy anon JWT, which is deprecated by the
# end of 2026. It is designed to ship inside a client bundle: row-level security is the boundary,
# not the key. The sb_secret_… key must never enter src/ or this file.
#
# Leaving it blank costs nothing on web or in the simulator; a physical device will refuse to boot
# with a message naming these two variables.

EXPO_PUBLIC_SUPABASE_URL_CLOUD=https://gvosanjceygakbubjfkv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY_CLOUD=

# Optional. Forces a target regardless of platform: `local` or `cloud`. Two clients on one database
# for a side-by-side test:  EXPO_PUBLIC_SUPABASE_TARGET=cloud npm run web
# EXPO_PUBLIC_SUPABASE_TARGET=
