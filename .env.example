# Copy to .env (gitignored) and restart the dev server — Metro inlines EXPO_PUBLIC_* at build time.
#
# These point at the local stack from `npx supabase start`. The local anon key derives from the
# default JWT secret in supabase/config.toml, so it is the same for anyone who checks this repo
# out and is safe to commit. Re-read it any time with `npx supabase status`.
#
# A phone running Expo Go cannot reach 127.0.0.1 on this machine; web is the verification path.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
