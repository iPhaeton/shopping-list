{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "react", "node"]
  },
  // Replaces the base's list rather than adding to it, so its entries are restated. The Edge
  // Functions under supabase/functions run on Deno, with `npm:` imports and the `Deno` global that
  // this project's TypeScript knows nothing of.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions"
  ]
}
